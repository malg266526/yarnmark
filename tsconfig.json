{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ES2022",
    "strict": true,
    "lib": ["DOM", "ES2020", "ES2021.String"],
    "jsx": "react",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "Node"
  }
}
