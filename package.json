{
  "name": "yarnmark",
  "version": "0.0.1",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "prettier": "prettier src/**/*.{ts,tsx} --write",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-transform-types src/**/*.test.ts",
    "start": "vite",
    "bundle": "vite build",
    "preview": "vite preview --port 8090 --strictPort",
    "edition:check": "node --experimental-transform-types ./workflow-helpers/checkEdition.ts",
    "transpile-workflow-files": "esbuild --target=es2022 --allow-overwrite --out-extension:.js=.mjs --outdir=workflow-helpers ./workflow-helpers/**",
    "stats": "node ./workflow-helpers/getDirMetadata.mjs",
    "compare-stats": "node ./workflow-helpers/compareMetadata.mjs",
    "create-github-table": "node ./workflow-helpers/createGithubTable.mjs",
    "check:unused": "npx knip",
    "prepare": "husky"
  },
  "author": "JM & MT",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@iconify/react": "6.0.4",
    "@types/argv": "0.0.8",
    "@types/bytes": "3.1.7",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/react-modal": "3.16.3",
    "@vitejs/plugin-react": "6.3.0",
    "argv": "0.0.3",
    "bytes": "3.1.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "1.4.0",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@hookform/resolvers": "7.0.9",
    "i18next": "27.2.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.3",
    "react-modal": "3.16.3",
    "react-router": "8.5.3",
    "styled-components": "6.7.0",
    "zod": "4.6.7"
  },
  "resolutions": {
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0"
  }
}
